{
  "name": "obsidian-retrieva",
  "version": "0.0.14",
  "description": "Markdown-native spaced repetition for Obsidian",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && node esbuild.config.mjs production",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:vault": "jiti scripts/generate-test-cards.ts",
    "sync:vault": "jiti scripts/sync-vault-plugin.ts"
  },
  "keywords": [
    "obsidian",
    "spaced-repetition",
    "fsrs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "ts-fsrs": "^5.2.3",
    "yaml": "^2.9.0"
  }
}
